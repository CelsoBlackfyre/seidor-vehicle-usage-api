{
  "name": "seidor-vehicle-usage-api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "WebAPI for managing automobiles, drivers and automobile usage.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
